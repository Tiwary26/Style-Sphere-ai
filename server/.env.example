PORT=5000
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.example.mongodb.net/stylesphere?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_EXPIRE=7d

# Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary credentials (optional, falls back to local storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Node Environment
NODE_ENV=development
